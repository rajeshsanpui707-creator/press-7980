# Server Environment Mode
NODE_ENV="production"

# Server Port (Cloud Run / Container default, falls back to 3000)
PORT="3000"

# ADMIN_USERNAME: Administrator username
ADMIN_USERNAME="admin@momentpress.in"

# ADMIN_PASSWORD: Set administrator production password securely via secrets/environment.
# If omitted, default initial setup credentials will apply on the administrator route (/admin/2008).
# ADMIN_PASSWORD="your-strong-production-password"

# VITE_GSC_VERIFICATION_TOKEN: Optional Google Search Console verification token.
# Can also be set directly in the Admin CMS Settings.
# VITE_GSC_VERIFICATION_TOKEN="your-gsc-token"

# Google Sheets Secondary Order Sync
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbzU16alieq9I9EZHbuRcXhovwqzJxspzSL8_DmTD_j21OmxeZWuxYVpdyP68bLboCdM/exec
GOOGLE_SHEETS_SYNC_SECRET=

# Google Drive Dedicated Bill PDF Storage
# Dedicated folder ID: 1TB6Vfcj6AID8IR66OKcLZ7FbwYX8cPnq
GOOGLE_DRIVE_FOLDER_ID=1TB6Vfcj6AID8IR66OKcLZ7FbwYX8cPnq

# Option 1: Personal Google OAuth Desktop Client (Recommended - No Service Account needed)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Option 2: Google Service Account
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


